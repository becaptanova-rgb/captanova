6:["$","ul",null,{"children":[["$","li",null,{"children":"Usage data such as pages visited, time spent, and referring URLs, via Google Analytics."}],["$","li",null,{"children":"Advertising and conversion data via Meta Pixel, used to measure and improve our ad campaigns."}],["$","li",null,{"children":"Standard technical data (IP address, browser type, device type) collected by our hosting provider for security and performance purposes."}]]}]
7:["$","h2",null,{"children":"3. How We Use Your Information"}]
8:["$","ul",null,{"children":[["$","li",null,{"children":"To create and deliver your Captanova Growth Profile™, program access, and masterclass registration."}],["$","li",null,{"children":"To process payments and send purchase confirmations and receipts."}],["$","li",null,{"children":"To send you programme-related emails, reminders, and (if you've opted in) marketing communications — you can unsubscribe at any time."}],["$","li",null,{"children":"To respond to your enquiries via email or WhatsApp."}],["$","li",null,{"children":"To improve our Services, content, and marketing based on aggregated, anonymised usage patterns."}],["$","li",null,{"children":"To comply with legal obligations, including tax and accounting record-keeping."}]]}]
9:["$","h2",null,{"children":"4. Who We Share Your Information With"}]
a:["$","p",null,{"children":"We do not sell your personal information. We share limited data with the following third-party service providers, solely to operate the Services:"}]
b:["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Razorpay"}]," — payment processing for paid programs."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Resend"}]," — transactional emails (confirmations, welcome emails, reminders)."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Google Sheets / Google Apps Script"}]," — internal record-keeping of leads, registrations, and purchases."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Meta (Facebook/Instagram) Pixel"}]," and ",["$","strong",null,{"children":"Google Analytics"}]," — website analytics and advertising measurement."]}],["$","li",null,{"children":[["$","strong",null,{"children":"WhatsApp Business"}]," — if you choose to contact us or opt in to WhatsApp reminders."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Amazon"}]," — if you purchase \"The Awareness Journal\", that transaction is completed entirely on Amazon's platform and governed by Amazon's own privacy policy, not this one."]}]]}]
c:["$","p",null,{"children":"Each of these providers processes data under their own privacy and security policies. We choose providers that maintain industry-standard security practices."}]
d:["$","h2",null,{"children":"5. Cookies & Tracking"}]
e:["$","p",null,{"children":"We use cookies and similar technologies (via Google Analytics and Meta Pixel) to understand how visitors use our site and to measure the effectiveness of our marketing. You can disable cookies in your browser settings, though some site features may not function as intended if you do."}]
f:["$","h2",null,{"children":"6. Data Retention"}]
10:["$","p",null,{"children":["We retain personal information for as long as necessary to provide the Services, comply with our legal and tax obligations (typically ",["$","span",null,{"className":"placeholder","children":"[X years, per applicable tax law]"}],"), resolve disputes, and enforce our agreements. You may request deletion of your data at any time as described in Section 8, subject to our legal retention obligations."]}]
11:["$","h2",null,{"children":"7. Data Security"}]
12:["$","p",null,{"children":"We implement reasonable technical and organisational measures — including encrypted connections (HTTPS), signature-verified payment confirmation via Razorpay, and restricted access to stored data — to protect your personal information. However, no method of transmission or storage over the internet is 100% secure, and we cannot guarantee absolute security."}]
13:["$","h2",null,{"children":"8. Your Rights"}]
14:["$","p",null,{"children":"You have the right to:"}]
15:["$","ul",null,{"children":[["$","li",null,{"children":"Access the personal information we hold about you."}],["$","li",null,{"children":"Request correction of inaccurate or incomplete information."}],["$","li",null,{"children":"Request deletion of your personal information, subject to legal retention requirements."}],["$","li",null,{"children":"Withdraw consent to marketing communications at any time."}],["$","li",null,{"children":"Lodge a complaint with our Grievance Officer (Section 11) if you believe your data has been mishandled."}]]}]
16:["$","p",null,{"children":["To exercise any of these rights, email us at"," ",["$","span",null,{"className":"placeholder","children":"[privacy@captanova.com]"}],"."]}]
17:["$","h2",null,{"children":"9. Children's Privacy"}]
18:["$","p",null,{"children":"Our Services are intended for individuals aged 18 and above. We do not knowingly collect personal information from anyone under 18 without verifiable parental or guardian consent. If you believe a minor has provided us with personal information, please contact us so we can remove it."}]
19:["$","h2",null,{"children":"10. International Visitors"}]
1a:["$","p",null,{"children":"Our Services are primarily operated for users in India and our servers/service providers may be located in India or other countries. By using our Services, you consent to the transfer and processing of your information in accordance with this policy, wherever our service providers are located."}]
1b:["$","h2",null,{"children":"11. Grievance Officer"}]
1c:["$","p",null,{"children":"In accordance with the Information Technology Act, 2000 and the rules made thereunder, the contact details of our Grievance Officer are:"}]
1d:["$","ul",null,{"children":[["$","li",null,{"children":["Name: ",["$","span",null,{"className":"placeholder","children":"[Grievance Officer Name]"}]]}],["$","li",null,{"children":["Email: ",["$","span",null,{"className":"placeholder","children":"[grievance@captanova.com]"}]]}],["$","li",null,{"children":["Address: ",["$","span",null,{"className":"placeholder","children":"[Registered Business Address]"}]]}]]}]
1e:["$","p",null,{"children":"We aim to acknowledge complaints within 24 hours and resolve them within 15 days, as required by law."}]
1f:["$","h2",null,{"children":"12. Changes to This Policy"}]
20:["$","p",null,{"children":"We may update this Privacy Policy from time to time. Material changes will be reflected by an updated \"Last updated\" date at the top of this page. Continued use of our Services after changes constitutes acceptance of the revised policy."}]
