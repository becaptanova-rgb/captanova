8:["$","div",null,{"className":"legal-prose","children":[["$","h2",null,{"children":"1. Overview"}],["$","p",null,{"children":"We want you to feel confident about investing in your growth with Captanova. This policy explains when refunds are available, how to request one, and how long processing takes. This policy is provided in line with the Consumer Protection (E-Commerce) Rules, 2020."}],["$","h2",null,{"children":"2. Free Masterclasses & Assessments"}],["$","p",null,{"children":"Our masterclasses and self-assessment quiz are free of charge, so no payment is collected and no refund is applicable. If you registered and can no longer attend, no action is required — a replay link (where available) will be sent to your registered email."}],["$","h2",null,{"children":"3. Digital Coaching Programs"}],["$","p",null,{"children":"This section applies to paid, digital coaching programs purchased directly on captanovaacademy.com (e.g. Mindset Mastery, the Captanova Transformation System™, and Leadership Mentorship)."}],["$","ul",null,{"children":[["$","li",null,{"children":["You may request a full refund within"," ",["$","span",null,{"className":"placeholder","children":"[X days — e.g. 7 days]"}]," of your purchase date, provided you have ",["$","strong",null,{"children":"not"}]," accessed more than"," ",["$","span",null,{"className":"placeholder","children":"[X% — e.g. 20%]"}]," of the program content and/or attended more than ",["$","span",null,{"className":"placeholder","children":"[X — e.g. 1]"}]," live session (whichever is more restrictive for the relevant program)."]}],["$","li",null,{"children":["Once the refund window has passed, or the usage threshold above has been exceeded, purchases are ",["$","strong",null,{"children":"non-refundable"}],", as digital access and coach time have already been delivered."]}],["$","li",null,{"children":"For mentorship or 1:1 programs already in progress, no refund is available for sessions already completed; a pro-rated refund for genuinely unused, future sessions may be considered at our discretion in exceptional circumstances (e.g. serious medical emergency), evaluated case by case."}]]}],["$","h2",null,{"children":"4. \"The Awareness Journal\""}],["$","p",null,{"children":["The Awareness Journal is sold via Amazon (paperback and Kindle), not directly by Captanova. Any return, refund, or exchange for this product is governed entirely by"," ",["$","a",null,{"href":"https://www.amazon.in/gp/help/customer/display.html","target":"_blank","rel":"noopener noreferrer","children":"Amazon's own return policy"}]," ","for the applicable format. Please contact Amazon customer service directly for any issue with this purchase."]}],["$","h2",null,{"children":"5. Non-Refundable Circumstances"}],["$","p",null,{"children":"We do not offer refunds in the following situations:"}],["$","ul",null,{"children":[["$","li",null,{"children":"Change of mind after the applicable refund window (Section 3) has passed."}],["$","li",null,{"children":"Failure to attend live sessions or complete the program at your own pace, where content remains accessible to you."}],["$","li",null,{"children":["Removal from a program for violating our ",["$","a",null,{"href":"/terms-of-service","children":"Terms of Service"}],"."]}],["$","li",null,{"children":"Dissatisfaction with personal results, where the program was delivered as described (see \"No Guaranteed Results\" in our Terms of Service)."}]]}],["$","h2",null,{"children":"6. How to Request a Refund"}],["$","p",null,{"children":["To request a refund, email us at ",["$","span",null,{"className":"placeholder","children":"[refunds@captanova.com]"}]," with:"]}],["$","ul",null,{"children":[["$","li",null,{"children":"Your full name and the email address used at checkout."}],["$","li",null,{"children":"Your Razorpay order ID or payment ID (found in your purchase confirmation email)."}],"$L10"]}],"$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19"]}]
