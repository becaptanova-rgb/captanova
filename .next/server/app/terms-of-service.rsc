8:["$","div",null,{"className":"legal-prose","children":[["$","h2",null,{"children":"1. Agreement to Terms"}],["$","p",null,{"children":["These Terms of Service (\"Terms\") govern your access to and use of captanovaacademy.com and all coaching programs, masterclasses, journals, and related digital products offered by ",["$","span",null,{"className":"placeholder","children":"[Registered Business Name / Entity Type]"}]," ","(\"Captanova\", \"we\", \"us\"). By registering for a masterclass, purchasing a program, or otherwise using our Services, you agree to be bound by these Terms. If you do not agree, please do not use our Services."]}],["$","h2",null,{"children":"2. Eligibility"}],["$","p",null,{"children":"Our Services are intended for individuals aged 18 and above. If you are under 18, you may only use our Services with the involvement and consent of a parent or legal guardian."}],["$","h2",null,{"children":"3. Our Services"}],["$","p",null,{"children":"Captanova offers, among other things:"}],["$","ul",null,{"children":[["$","li",null,{"children":"Free live masterclasses and self-assessment quizzes."}],["$","li",null,{"children":"Paid coaching programs, including but not limited to Mindset Mastery, the Captanova Transformation System™, and Leadership Mentorship."}],["$","li",null,{"children":"\"The Awareness Journal\" — a physical/Kindle book sold via Amazon, subject to Amazon's own terms and policies, not these Terms."}]]}],["$","p",null,{"children":"Program formats, curricula, session counts, and delivery methods (live, recorded, group, or 1:1) are as described on the relevant program page at the time of your purchase and may be updated by us from time to time for future cohorts."}],["$","h2",null,{"children":"4. Payments & Pricing"}],["$","ul",null,{"children":[["$","li",null,{"children":"All prices are listed in Indian Rupees (₹) and are inclusive/exclusive of applicable taxes as stated at checkout."}],["$","li",null,{"children":"Payments are processed securely through Razorpay. We do not store your card, UPI, or banking details."}],["$","li",null,{"children":"Access to paid programs is granted only after successful payment verification."}],["$","li",null,{"children":["Refunds, where applicable, are governed by our separate ",["$","a",null,{"href":"/refund-policy","children":"Refund Policy"}],"."]}]]}],["$","h2",null,{"children":"5. Intellectual Property"}],["$","p",null,{"children":"All content provided as part of our Services — including but not limited to session recordings, worksheets, frameworks, the Captanova Growth Profile™ methodology, and written materials — is the intellectual property of Captanova and is licensed to you for personal, non-commercial use only. You may not copy, reproduce, distribute, resell, or publicly share this content without our prior written consent."}],["$","h2",null,{"children":"6. Not Medical, Psychological, or Financial Advice"}],["$","p",null,{"children":["Captanova's coaching, masterclasses, and content are for educational and personal development purposes only. They are ",["$","strong",null,{"children":"not"}]," a substitute for professional medical, psychiatric, psychological, legal, or financial advice. Coaching is not therapy or mental health treatment. If you are experiencing a mental health crisis, please seek help from a licensed professional or a crisis helpline immediately. Nothing in our Services should be relied upon as medical or clinical guidance."]}],["$","h2",null,{"children":"7. No Guaranteed Results"}],["$","p",null,{"children":"Testimonials, case studies, and results shared on our website and marketing materials reflect individual experiences and are not guarantees of similar results for every participant. Your outcomes depend on factors including your effort, consistency, and personal circumstances. We make no promise that any program will achieve a specific financial, career, relationship, or personal outcome."}],"$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d"]}]
