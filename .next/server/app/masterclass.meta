{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/masterclass/layout,_N_T_/masterclass/page,_N_T_/masterclass"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/masterclass/__PAGE__",
    "/masterclass",
    "/_index",
    "/_head"
  ]
}